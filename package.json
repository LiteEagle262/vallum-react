{
  "name": "@vallum/react",
  "version": "0.1.0",
  "description": "Lifecycle-safe React bindings for the Vallum browser SDK",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build && node ../../scripts/prepare-package-license.mjs .",
    "postpack": "node ../../scripts/cleanup-package-license.mjs ."
  },
  "dependencies": {
    "@vallum/client": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vallum-proxy/vallum.git",
    "directory": "packages/vallum-react"
  },
  "homepage": "https://github.com/vallum-proxy/vallum#readme",
  "bugs": {
    "url": "https://github.com/vallum-proxy/vallum/issues"
  },
  "keywords": [
    "vallum",
    "react",
    "security",
    "browser-sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
